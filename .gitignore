# WordPress — core and wp-content live in a Docker named volume (wp_data),
# never on the host filesystem, except wordpress/custom-plugin/ which IS
# tracked. Nothing to ignore here today; kept as a guard against accidental
# future dumps.
wordpress/**/*.sql
wordpress/**/*.sql.gz

