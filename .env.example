# Copy to .env and fill in — never commit the real .env file.

# --- MariaDB ---
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=cofeo_wp
MYSQL_USER=cofeo
MYSQL_PASSWORD=change-me

# --- WordPress ---
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_NAME=cofeo_wp
WORDPRESS_DB_USER=cofeo
WORDPRESS_DB_PASSWORD=change-me
WORDPRESS_URL=http://localhost:8080
WP_ADMIN_USER=cofeo_admin
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=dev@cofeo.local

# --- Adminer (DB browser UI) ---
ADMINER_PORT=8081

# --- WooCommerce REST API (server-side only) ---
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# --- Next.js ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WORDPRESS_API_URL=http://localhost:8080
